{
  "backend_url": {
    "type": "string",
    "description": "Tsugu 后端地址",
    "hint": "Tsugu API 后端服务器地址，默认为官方后端",
    "default": "http://tsugubot.com:8080"
  },
  "userdata_backend_url": {
    "type": "string",
    "description": "用户数据后端地址",
    "hint": "用户数据后端服务器地址（用于绑定等功能），默认与主后端相同",
    "default": "http://tsugubot.com:8080"
  },
  "proxy": {
    "type": "string",
    "description": "代理地址",
    "hint": "HTTP 代理地址，留空则不使用代理",
    "default": ""
  },
  "use_easy_bg": {
    "type": "bool",
    "description": "使用简易背景",
    "hint": "使用简易背景可降低图片质量但加快响应速度",
    "default": true
  },
  "compress": {
    "type": "bool",
    "description": "压缩返回数据",
    "hint": "压缩返回数据以减少数据传输量",
    "default": true
  }
}
